PORT=8080
# Bind address; the Compose setup uses 0.0.0.0 inside the container.
HOST=127.0.0.1
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/blogs"
# Only for `npm run test:integration`; the suite deletes every row in this database.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/blogs_test"
# At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_KEY=""
REACT_APP_URL="http://localhost:3000"
