{
  "name": "rest-express",
  "version": "1.0.0",
  "description": "A RESTful APIs backend built with Express.js for handling user authentication and post management.",
  "license": "MIT",
  "scripts": {
    "start": "ts-node src/app.ts",
    "dev": "nodemon src/app.ts",
    "pretty": "prettier --write \"./**/*.{js,jsx,ts,tsx,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --require ts-node/register \"tests/unit/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --require ts-node/register \"tests/integration/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "4.18.2",
    "jsonwebtoken": "^9.0.1",
    "morgan": "^1.10.0",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/node": "18.16.19",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "eslint": "^8.45.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "prisma": "5.0.0",
    "supertest": "^6.3.3",
    "ts-node": "10.9.1",
    "typescript": "5.1.6"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
