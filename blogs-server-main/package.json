{
  "name": "fieldnotes-api",
  "version": "1.0.0",
  "description": "Express + Prisma API for the Fieldnotes shared feed: signup, login and a shared post feed.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app.js",
    "dev": "nodemon src/app.ts",
    "seed": "prisma db seed",
    "pretty": "prettier --write \"{src,tests,prisma}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format:check": "prettier --check \"{src,tests,prisma}/**/*.ts\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --require ts-node/register \"tests/unit/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --require ts-node/register \"tests/integration/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
