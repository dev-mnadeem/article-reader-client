# Copy to .env.local and adjust. Create React App inlines every REACT_APP_*
# variable into the bundle at build time, so nothing secret belongs in here.

# Base URL of the blogs-server API, including the /api prefix.
# Defaults to a same-origin /api when unset, which is what the nginx image
# expects when the API is proxied under the same host.
REACT_APP_API_URL="http://localhost:8080/api"

# Port the development server listens on (Create React App convention).
# PORT=3000
